{
  "name": "fingerprint-monorepo",
  "private": true,
  "description": "Open-source browser fingerprinting: a tiny Light build and an exhaustive Advanced build.",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/core",
    "packages/light",
    "packages/advanced"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:browser": "node tests/browser/run.mjs",
    "demo": "npm run build && node examples/serve.mjs"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
